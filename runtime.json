{
  "schemaVersion": 1,
  "name": "kilo",
  "displayName": "kilo",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": { "KILO_CONFIG_DIR": "${STATE_DIR}/kilo" },
  "preflight": [{ "path": "${STATE_DIR}/kilo", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "kilo",
    "launch": ["launch-kilo"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
